#!/usr/bin/env bash
# Every local gate in one script (docs/PLAN.md §13.2). There is no CI: agents and the owner run
# this before a change is committed. It stops at the first failing step with a non-zero exit.
#
#   script/check               steps 1-5
#   script/check --fast        steps 1-4 (skips the e2e scenarios)
#   script/check --e2e-only    step 5 alone: CI runs it as a job of its own beside --fast, so
#                              the two together are steps 1-5 (PLAN §13.4)
#   script/check --foreground  also the foreground scenarios in tests/e2e/foreground (step 5)
#   script/check --linux       also step 6: the headless crates and dv inside WSL Ubuntu, the
#                              Linux build (script/build-linux) and the real WSL from Windows:
#                              the app's connection, `dv setup wsl` and the CLI run inside it;
#                              run inside a distro, the first two there and no real-WSL step
#   script/check --linux-gui   also step 7: the Linux app (dv's GUI shapes, dv_ui and
#                              dv_e2e) linted and tested inside WSL Ubuntu, and the e2e
#                              scenarios there on an Xvfb display the runner starts (never
#                              WSLg's); run on a Linux host, right there
set -euo pipefail

usage() {
    cat <<'EOF'
usage: script/check [--fast | --e2e-only] [--foreground] [--linux] [--linux-gui]

  1. cargo fmt --all --check
  2. cargo clippy in dv's three shapes: default (gui + automation), the shipped app
     (-p dv --no-default-features --features gui), headless (-p dv --no-default-features)
  3. gpui boundary: no gpui in the headless crates' or the headless dv's dependency trees
  4. cargo test --workspace
  5. e2e scenarios in tests/e2e through dv_e2e (background)   skipped with --fast
     and tests/e2e/foreground (takes the focus; hands off)    only with --foreground
     (--e2e-only: this step alone)
  6. the headless crates and the headless dv tested and linted inside WSL Ubuntu,
     script/build-linux, then the real WSL (sandboxed under /tmp)  only with --linux
  7. the Linux app inside WSL Ubuntu: clippy in its GUI shapes, the gpui crates' tests and
     the e2e scenarios on an Xvfb display of the runner's own     only with --linux-gui
     (its scenarios skipped with --fast)
EOF
}

fast=0
e2e_only=0
foreground=0
linux=0
linux_gui=0
for arg in "$@"; do
    case "$arg" in
        --fast) fast=1 ;;
        --e2e-only) e2e_only=1 ;;
        --foreground) foreground=1 ;;
        --linux) linux=1 ;;
        --linux-gui) linux_gui=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "script/check: unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$fast" -eq 1 && "$foreground" -eq 1 ]]; then
    echo "script/check: --fast skips the e2e step that --foreground adds to" >&2
    exit 2
fi
if [[ "$e2e_only" -eq 1 && ("$fast" -eq 1 || "$linux" -eq 1 || "$linux_gui" -eq 1) ]]; then
    echo "script/check: --e2e-only is step 5 alone, without --fast, --linux or --linux-gui" >&2
    exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

step() {
    printf '\n==> [%s] %s\n' "$1" "$2"
}

# The crates that must never depend on gpui, even transitively (PLAN §4).
headless_crates=(dv_core dv_backend dv_cli dv_lsp mock_gh mock_lsp dv_test_support dv_package dv_e2e)

if [[ "$e2e_only" -eq 0 ]]; then
    step 1 "cargo fmt --all --check"
    cargo fmt --all --check

    # dv's three shapes (PLAN §13.1): each drifts silently unless it is linted on its own.
    step 2 "cargo clippy --workspace --all-targets -- -D warnings  (dv: gui + automation)"
    cargo clippy --workspace --all-targets -- -D warnings
    step 2 "cargo clippy -p dv --no-default-features --features gui --all-targets -- -D warnings  (the shipped app)"
    cargo clippy -p dv --no-default-features --features gui --all-targets -- -D warnings
    step 2 "cargo clippy -p dv --no-default-features --all-targets -- -D warnings  (headless: the WSL build)"
    cargo clippy -p dv --no-default-features --all-targets -- -D warnings

    step 3 "gpui boundary: ${headless_crates[*]} and the headless dv"
    boundary_ok=1
    # Normal dependencies only (dev-dependencies may use gpui's test support), every target
    # platform, one crate per line without tree drawing. `$1` names the check, the rest are
    # `cargo tree`'s package and feature arguments.
    check_boundary() {
        local name="$1"
        shift
        local tree offenders
        tree="$(cargo tree "$@" -e normal --target all --prefix none)"
        # gpui's own crates (gpui-pre*, gpui-component, gpui-base, gpui-kit-assets) are hyphenated;
        # toolbox-rs's gpui-free automation crates (gpui_automation_runner, …_protocol) are not.
        offenders="$(printf '%s\n' "$tree" | grep -E '^gpui-' | sed 's/ (\*)$//' | sort -u || true)"
        if [[ -n "$offenders" ]]; then
            boundary_ok=0
            echo "error: $name depends on gpui:" >&2
            printf '%s\n' "$offenders" | sed 's/^/  /' >&2
            echo "  (cargo tree $* -e normal --target all -i <name> shows the path to one)" >&2
        else
            echo "ok: $name"
        fi
    }
    for crate in "${headless_crates[@]}"; do
        check_boundary "$crate" -p "$crate" --all-features
    done
    # The static musl build installed into WSL distros: the CLI and `dv backend --stdio`.
    check_boundary "dv --no-default-features" -p dv --no-default-features
    if [[ "$boundary_ok" -ne 1 ]]; then
        exit 1
    fi

    step 4 "cargo test --workspace"
    cargo test --workspace
fi

if [[ "$fast" -eq 1 ]]; then
    step 5 "e2e scenarios: skipped (--fast)"
else
    shopt -s nullglob
    scenarios=(tests/e2e/*.jsonl)
    shopt -u nullglob
    if [[ ${#scenarios[@]} -eq 0 ]]; then
        step 5 "e2e scenarios: none in tests/e2e, nothing to run"
    else
        # An all-targets build (and `cargo test`, once a bin crate has integration tests) can
        # relink the binaries with gpui's test support (leak detection and other test-only
        # machinery), so the runner gets freshly built plain ones right before it starts them; the
        # runner itself never builds anything.
        step 5 "cargo build -p dv -p mock_gh -p mock_lsp  (plain binaries for the runner)"
        cargo build -p dv -p mock_gh -p mock_lsp
        step 5 "e2e scenarios: cargo run -p dv_e2e --bin e2e -- tests/e2e"
        cargo run -p dv_e2e --bin e2e -- tests/e2e
    fi
    if [[ "$foreground" -eq 1 ]]; then
        # These take the foreground for a few seconds each (tests/e2e/README.md, "Screenshots
        # and window materials"), so only an explicit flag runs them.
        step 5 "cargo build -p dv -p mock_gh -p mock_lsp  (plain binaries for the runner)"
        cargo build -p dv -p mock_gh -p mock_lsp
        step 5 "foreground e2e scenarios: cargo run -p dv_e2e --bin e2e -- tests/e2e/foreground"
        cargo run -p dv_e2e --bin e2e -- tests/e2e/foreground
    fi
fi

if [[ "$linux" -eq 1 ]]; then
    # The headless crates and the headless dv (PLAN §13.1), the WSL build's own code, tested and
    # linted on Linux; then the static Linux build (script/build-linux); then, on Windows, the
    # real WSL through it (crates/dv_backend/tests/wsl.rs, `dv setup wsl`'s own check, and the
    # CLI run inside the distro: dv_cli's in-process crossing and crates/dv/tests/wsl_cli.rs).
    linux_tests=(
        "cargo test -p dv_core -p dv_backend -p dv_cli -p dv_lsp -p dv_test_support -p mock_gh -p mock_lsp"
        "cargo test -p dv --no-default-features"
        "cargo clippy -p dv_backend -p dv_cli -p dv_lsp -p mock_lsp -p dv --no-default-features --all-targets -- -D warnings"
    )
    # Linux first: inside a WSL distro, interop puts wsl.exe on PATH too, and the tests belong
    # to the distro they run in. The hop through wsl.exe, and the real-WSL step, are Windows'.
    case "$(uname -s)" in
        Linux)
            for command in "${linux_tests[@]}"; do
                step 6 "Linux: $command"
                bash -c "$command"
            done
            step 6 "script/build-linux --debug-only"
            bash script/build-linux --debug-only
            echo "script/check: skipped the real-WSL step (the app's connection, dv setup wsl," \
                "the CLI's crossing): it runs from Windows"
            ;;
        MINGW* | MSYS* | CYGWIN*)
            if ! command -v wsl.exe > /dev/null 2>&1; then
                echo "script/check: --linux needs wsl.exe and WSL Ubuntu" >&2
                exit 1
            fi
            # Inside Ubuntu, on the same checkout through /mnt, with the target dir on the
            # distro's ext4 disk: building onto /mnt (9P) is many times slower. rustup installs
            # the toolchain from rust-toolchain.toml on first use.
            win_root="$(cygpath -w "$root")"
            for command in "${linux_tests[@]}"; do
                step 6 "WSL Ubuntu: $command"
                MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu --cd "$win_root" --exec bash -lc \
                    "CARGO_TARGET_DIR=\"\$HOME/.cache/dv-target\" $command"
            done
            step 6 "script/build-linux --debug-only  (target/debug/dv-linux-x86_64)"
            bash script/build-linux --debug-only
            # Every script the tests run in the distro gets this fresh folder under its /tmp
            # as $HOME (DV_WSL_HOME), never the distro user's own; each test removes its part
            # of it. MSYS_NO_PATHCONV keeps Git Bash from rewriting the POSIX path into a
            # Windows one.
            wsl_home="/tmp/dv-check-$$-$RANDOM"
            step 6 "Windows: the real WSL in Ubuntu, sandboxed in $wsl_home"
            wsl_status=0
            MSYS_NO_PATHCONV=1 DV_TEST_WSL_DISTRO=Ubuntu DV_WSL_HOME="$wsl_home" \
                cargo test -p dv_backend --test wsl -- --test-threads=1 || wsl_status=$?
            if [[ "$wsl_status" -eq 0 ]]; then
                MSYS_NO_PATHCONV=1 DV_TEST_WSL_DISTRO=Ubuntu DV_WSL_HOME="$wsl_home" \
                    cargo test -p dv_cli --lib -- setup_wsl reexec doctor --test-threads=1 ||
                    wsl_status=$?
            fi
            if [[ "$wsl_status" -eq 0 ]]; then
                MSYS_NO_PATHCONV=1 DV_TEST_WSL_DISTRO=Ubuntu DV_WSL_HOME="$wsl_home" \
                    cargo test -p dv --test wsl_cli -- --test-threads=1 || wsl_status=$?
            fi
            if [[ "$wsl_status" -eq 0 ]]; then
                MSYS_NO_PATHCONV=1 DV_TEST_WSL_DISTRO=Ubuntu DV_WSL_HOME="$wsl_home" \
                    cargo test -p dv_lsp --test wsl_shell -- --test-threads=1 || wsl_status=$?
            fi
            if ! MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu --cd / --exec rmdir "$wsl_home" \
                2> /dev/null; then
                echo "script/check: $wsl_home in Ubuntu wasn't empty or wasn't made; look" \
                    "at it" >&2
            fi
            if [[ "$wsl_status" -ne 0 ]]; then
                exit "$wsl_status"
            fi
            ;;
        *)
            echo "script/check: --linux needs Windows (with WSL Ubuntu) or a Linux host" >&2
            exit 1
            ;;
    esac
fi

if [[ "$linux_gui" -eq 1 ]]; then
    # The Linux app (PLAN §13.1, §13.2), in a target dir of its own (gpui with X11 and Wayland,
    # apart from step 6's headless one). The tests reach no display (gpui's test platform); the
    # scenarios run on an Xvfb display the e2e runner starts and ends, never the desktop's
    # (CLAUDE.md, "GUI runs"); their screenshots land in <that target dir>/e2e.
    linux_gui_steps=(
        "cargo clippy -p dv -p dv_ui -p dv_e2e --all-targets -- -D warnings"
        "cargo clippy -p dv --no-default-features --features gui --all-targets -- -D warnings"
        "env -u DISPLAY -u WAYLAND_DISPLAY cargo test -p dv -p dv_ui -p dv_e2e"
    )
    # The scenarios, as step 5 runs them; --fast skips them here too.
    if [[ "$fast" -eq 0 ]]; then
        linux_gui_steps+=(
            "cargo build -p dv -p mock_gh -p mock_lsp"
            "cargo run -p dv_e2e --bin e2e -- tests/e2e"
        )
    fi
    case "$(uname -s)" in
        Linux)
            # The Linux GUI target dir here too, unless the caller named one.
            export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/.cache/dv-target-gui}"
            for command in "${linux_gui_steps[@]}"; do
                step 7 "Linux: $command  (CARGO_TARGET_DIR=$CARGO_TARGET_DIR)"
                bash -c "$command"
            done
            ;;
        MINGW* | MSYS* | CYGWIN*)
            if ! command -v wsl.exe > /dev/null 2>&1; then
                echo "script/check: --linux-gui needs wsl.exe and WSL Ubuntu" >&2
                exit 1
            fi
            win_root="$(cygpath -w "$root")"
            for command in "${linux_gui_steps[@]}"; do
                step 7 "WSL Ubuntu: $command"
                MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu --cd "$win_root" --exec bash -lc \
                    "CARGO_TARGET_DIR=\"\$HOME/.cache/dv-target-gui\" $command"
            done
            ;;
        *)
            echo "script/check: --linux-gui needs Windows (with WSL Ubuntu) or a Linux host" >&2
            exit 1
            ;;
    esac
fi

printf '\nscript/check: all steps passed\n'
