{"cmd": "cli", "args": ["comment", "annotate", "--review", "${review}", "--author", "claude-code", "--file", "src/routes/users.ts", "--lines", "7:14", "--body-file", "-", "--json"], "cwd": "repos/api-server", "stdin": "Pulled out of the route so the test can call it. Writes don't invalidate the entry yet: a renamed user shows the old name for up to a minute.\n", "save": {"on_fetch": "/json/thread/id"}, "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/thread/anchor/current", "equals": {"path": "src/routes/users.ts", "side": "new", "start_line": 7, "end_line": 14}}]}
{"cmd": "cli", "args": ["comment", "annotate", "--review", "${review}", "--author", "claude-code", "--file", "src/routes/users.test.ts", "--body-file", "-"], "cwd": "repos/api-server", "stdin": "Only the hit path is covered; the miss path needs a fake `db`.\n", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/stdout", "contains": "src/routes/users.test.ts (file)"}]}
