{"scenario": {"window_size": "1440x900", "description": "PLAN §19 end to end, the agent played by the real dv CLI: it hands its work over (dv review new, three annotations, dv review done with an overview) before the reviewer opens anything; the reviewer opens the working review to the handoff banner and the annotation cards beside the code, hides and shows them with A, lists them in the comments list, asks about one (R), requests changes; the agent sees the question as an open thread, answers and addresses it; the reviewer resolves it. Screenshots in dark Mica and one light."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle"}

// The agent's uncommitted work: a cache in front of the users route, and a test.
{"cmd": "seed_repo", "name": "api-server", "steps": [{"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await db.users.find(req.params.id);\n  if (!user) return res.status(404).end();\n  res.json({ id: user.id, name: user.name });\n});\n"}, {"commit": "base"}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport { cache } from \"../lib/cache\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nexport async function fetchUser(id: string): Promise<User | null> {\n  const key = `user:${id}`;\n  const hit = cache.get<User>(key);\n  if (hit) return hit;\n  const user = await db.users.find(id);\n  if (user) cache.set(key, user, 60_000);\n  return user;\n}\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await fetchUser(req.params.id);\n  if (!user) return res.status(404).json({ error: \"not_found\" });\n  res.json({ id: user.id, name: user.name });\n});\n"}, {"write": "src/lib/cache.ts", "text": "const entries = new Map<string, { value: unknown; until: number }>();\n\nexport const cache = {\n  get<T>(key: string): T | undefined {\n    const entry = entries.get(key);\n    return entry && entry.until > Date.now() ? (entry.value as T) : undefined;\n  },\n  set(key: string, value: unknown, ttl: number) {\n    entries.set(key, { value, until: Date.now() + ttl });\n  },\n};\n"}, {"write": "src/routes/users.test.ts", "text": "import { fetchUser } from \"./users\";\n\ntest(\"caches a user\", async () => {\n  expect(await fetchUser(\"a\")).toEqual(await fetchUser(\"a\"));\n});\n"}]}

