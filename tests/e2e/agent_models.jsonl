{"scenario": {"window_size": "1440x900", "description": "An agent's model (PLAN §2.5, DESIGN §4.1): agents answer a thread through the real dv CLI, each naming its model (--model, or $DV_MODEL under Claude Code); the card shows each reply by its model with the family's mark (Claude, OpenAI, Gemini, Kimi, DeepSeek, Z.ai for GLM, Qwen), the agent's own name in the tag; a model dv doesn't know and an agent that names none keep the bot glyph; the state chip and the ready banner name the model too. Screenshots in dark and light."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "set_setting", "key": "mode", "value": "dark"}
{"cmd": "settle"}
{"cmd": "seed_repo", "name": "api", "steps": [{"write": "src/total.ts", "text": "export function total(items: number[]): number {\n  let sum = 0;\n  for (const item of items) sum += item;\n  return sum;\n}\n"}, {"commit": "base"}, {"write": "src/total.ts", "text": "export function total(items: number[]): number {\n  return items.reduce((sum, item) => sum + item, 0);\n}\n"}], "save": {"repo": "/path"}}
{"cmd": "open_review", "path": "${repo}", "save": {"review": "/review_id"}}
{"cmd": "settle", "expect": [{"pointer": "/session/total", "equals": 1}]}

// The reviewer asks; every agent answers, naming its model.
{"cmd": "cli", "args": ["comment", "add", "--file", "src/total.ts", "--lines", "2", "--body", "Which of you wrote this?", "--json"], "cwd": "repos/api", "save": {"thread": "/json/thread/id"}, "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/thread/author/kind", "equals": "reviewer"}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--body", "Claude Fable 5.2 here.", "--json"], "cwd": "repos/api", "env": {"CLAUDECODE": "1", "DV_MODEL": "Claude Fable 5.2"}, "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "claude-code", "model": "Claude Fable 5.2"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "codex", "--model", "GPT 6.1 Sol", "--body", "GPT 6.1 Sol here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "codex", "model": "GPT 6.1 Sol"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "gemini-cli", "--model", "Gemini 4 Argon", "--body", "Gemini 4 Argon here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "gemini-cli", "model": "Gemini 4 Argon"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "kimi-cli", "--model", "Kimi K3", "--body", "Kimi K3 here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "kimi-cli", "model": "Kimi K3"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "opencode", "--model", "DeepSeek V4", "--body", "DeepSeek V4 here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "opencode", "model": "DeepSeek V4"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "opencode", "--model", "GLM 5", "--body", "GLM 5 here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "opencode", "model": "GLM 5"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "qwen-code", "--model", "Qwen 4 Max", "--body", "Qwen 4 Max here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "qwen-code", "model": "Qwen 4 Max"}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "opencode", "--model", "Llama 5", "--body", "Llama 5 here.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "opencode", "model": "Llama 5"}}]}
// An agent that names no model shows by its own name; --model without an agent is refused.
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--author", "cursor", "--body", "No model named.", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/reply/author", "equals": {"kind": "agent", "name": "cursor", "model": null}}]}
{"cmd": "cli", "args": ["comment", "reply", "${thread}", "--model", "Claude Fable 5.2", "--body", "x", "--json"], "cwd": "repos/api", "expect_result": [{"pointer": "/exit", "equals": 2}, {"pointer": "/json/error/code", "equals": "usage"}]}
{"cmd": "wait_for", "pointer": "/session/threads/0/replies", "len": 9}
{"cmd": "settle", "expect": [{"pointer": "/session/threads/0/replies/0/author", "equals": {"kind": "agent", "name": "claude-code", "model": "Claude Fable 5.2", "family": "claude"}}, {"pointer": "/session/threads/0/replies/1/author", "equals": {"kind": "agent", "name": "codex", "model": "GPT 6.1 Sol", "family": "gpt"}}, {"pointer": "/session/threads/0/replies/2/author", "equals": {"kind": "agent", "name": "gemini-cli", "model": "Gemini 4 Argon", "family": "gemini"}}, {"pointer": "/session/threads/0/replies/3/author", "equals": {"kind": "agent", "name": "kimi-cli", "model": "Kimi K3", "family": "kimi"}}, {"pointer": "/session/threads/0/replies/4/author", "equals": {"kind": "agent", "name": "opencode", "model": "DeepSeek V4", "family": "deepseek"}}, {"pointer": "/session/threads/0/replies/5/author", "equals": {"kind": "agent", "name": "opencode", "model": "GLM 5", "family": "glm"}}, {"pointer": "/session/threads/0/replies/6/author", "equals": {"kind": "agent", "name": "qwen-code", "model": "Qwen 4 Max", "family": "qwen"}}, {"pointer": "/session/threads/0/replies/7/author", "equals": {"kind": "agent", "name": "opencode", "model": "Llama 5", "family": null}}, {"pointer": "/session/threads/0/replies/8/author", "equals": {"kind": "agent", "name": "cursor", "model": null, "family": null}}]}
{"cmd": "screenshot", "name": "models-dark"}

// Addressed and handed back by Claude: the chip and the banner name the model.
{"cmd": "cli", "args": ["comment", "address", "${thread}", "--note", "It was me.", "--json"], "cwd": "repos/api", "env": {"CLAUDECODE": "1", "DV_MODEL": "Claude Fable 5.2"}, "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/thread/state", "equals": "addressed"}]}
{"cmd": "cli", "args": ["review", "done", "${review}", "--note", "All of us answered.", "--json"], "cwd": "repos/api", "env": {"CLAUDECODE": "1", "DV_MODEL": "Claude Fable 5.2"}, "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/review/status", "equals": "ready"}]}
{"cmd": "wait_for", "pointer": "/session/status", "equals": "ready"}
{"cmd": "settle", "expect": [{"pointer": "/session/threads/0/state", "equals": "addressed"}, {"pointer": "/session/ready_note/author", "equals": {"kind": "agent", "name": "claude-code", "model": "Claude Fable 5.2", "family": "claude"}}]}
{"cmd": "screenshot", "name": "handed-back-dark"}
{"cmd": "set_setting", "key": "mode", "value": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "handed-back-light"}
