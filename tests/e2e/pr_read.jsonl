// The strip at the window's least width (DESIGN §4.5), at its worst: pull request 12 has a
// long title, login and branch and three kinds of checks; its review is closed, so it stays
// at its head when the pull request moves on; and the refresh after that fails.
{"cmd": "repo_edit", "name": "api", "github": [{"checkout": "main"}, {"branch": "cache"}, {"checkout": "cache"}, {"write": "src/config.rs", "text": "pub fn config() -> u32 {\n    1\n}\n"}, {"commit": "Cache the config"}, {"pr": [12, "cache"]}], "save": {"cache": "/github/prs/12"}, "expect_result": {"pointer": "/github/prs/12", "equals": "295b0f6d20624fd69b34778efd752fa98450720d"}}
{"cmd": "open_pr", "path": "${api}", "pr": "#12", "save": {"review12": "/review_id"}, "expect_result": {"pointer": "/created", "equals": true}}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/pr_strip/number", "equals": 12}, {"pointer": "/pr_strip/checks", "equals": {"passing": 12, "failing": 1, "pending": 2}}, {"pointer": "/pr_strip/moved", "equals": null}]}
{"cmd": "cli", "cwd": "repos/api", "args": ["review", "close", "${review12}", "--json"], "expect_result": {"pointer": "/exit", "equals": 0}}
{"cmd": "wait_for", "pointer": "/session/status", "equals": "closed", "timeout_ms": 20000}
{"cmd": "repo_edit", "name": "api", "github": [{"write": "src/config.rs", "text": "// Cached.\npub fn config() -> u32 {\n    1\n}\n"}, {"commit": "Say that it is cached"}, {"pr": [12, "cache"]}], "save": {"cached": "/github/prs/12"}, "expect_result": {"pointer": "/github/prs/12", "equals": "15d2055096e2bc2d31cc1d505f61bc4200bb7a41"}}
{"cmd": "key", "keystroke": "secondary-r"}
{"cmd": "wait_for", "pointer": "/pr_strip/moved/kind", "equals": "ahead", "timeout_ms": 20000}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/pr_strip/moved", "equals": {"kind": "ahead", "from": "${cache}", "to": "${cached}", "commits": 1, "text": "1 new commit since this review's head"}}, {"pointer": "/pr_strip/read/kind", "equals": "read"}, {"pointer": "/session/pr/pins/head", "equals": "${cache}"}]}
{"cmd": "key", "keystroke": "secondary-r"}
{"cmd": "wait_for", "pointer": "/pr_strip/read/kind", "equals": "stale", "timeout_ms": 20000}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/pr_strip/moved/text", "equals": "1 new commit since this review's head"}, {"pointer": "/pr_strip/read/text", "equals": "Couldn't refresh · details"}, {"pointer": "/pr_strip/refreshing", "equals": false}]}
{"cmd": "screenshot", "name": "pr-strip-wide-worst"}
{"cmd": "resize", "w": 1100, "h": 700}
{"cmd": "settle"}
// What never gives way: the number, the state, the checks, the round, the line that says the
// refresh failed and the two buttons, each at its own width and inside the window (Open on
// GitHub ends 12 short of its right edge). What does: how far it moved, then the author and the
// branches, each down to the 36 that keeps an ellipsis under the pointer, then the title.
// Widths that depend on a platform's text are held to a range, wider where the font isn't
// macOS's (Segoe UI on Windows; on Linux whatever the system names, DejaVu Sans in CI, and
// the keycap reads "Ctrl R").
{"cmd": "bounds", "target": "pr_strip/number", "expect_result": {"pointer": "/visible/x", "equals": 12}}
{"cmd": "bounds", "target": "pr_strip/number", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/w", "gte": 18}, {"pointer": "/visible/w", "lte": 30}]}
{"cmd": "bounds", "target": "pr_strip/number", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/w", "gte": 15}, {"pointer": "/visible/w", "lte": 32}]}
{"cmd": "bounds", "target": "pr_strip/state", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/w", "gte": 36}, {"pointer": "/visible/w", "lte": 52}]}
{"cmd": "bounds", "target": "pr_strip/state", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/w", "gte": 36}, {"pointer": "/visible/w", "lte": 62}]}
{"cmd": "bounds", "target": "pr_strip/checks", "expect_result": [{"pointer": "/visible/w", "gte": 80}, {"pointer": "/visible/w", "lte": 120}]}
{"cmd": "bounds", "target": "pr_strip/round", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/w", "gte": 38}, {"pointer": "/visible/w", "lte": 58}]}
{"cmd": "bounds", "target": "pr_strip/round", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/w", "gte": 34}, {"pointer": "/visible/w", "lte": 66}]}
{"cmd": "bounds", "target": "pr_strip/refresh", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/x", "gte": 920}, {"pointer": "/visible/x", "lte": 990}, {"pointer": "/visible/w", "gte": 70}, {"pointer": "/visible/w", "lte": 136}]}
{"cmd": "bounds", "target": "pr_strip/refresh", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/x", "gte": 896}, {"pointer": "/visible/x", "lte": 990}, {"pointer": "/visible/w", "gte": 66}, {"pointer": "/visible/w", "lte": 160}]}
{"cmd": "bounds", "target": "pr_strip/open", "expect_result": [{"pointer": "/visible/x", "equals": 1064}, {"pointer": "/visible/w", "equals": 24}]}
{"cmd": "bounds", "target": "pr_strip/title", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/x", "gte": 34}, {"pointer": "/visible/x", "lte": 50}, {"pointer": "/visible/w", "gte": 200}]}
{"cmd": "bounds", "target": "pr_strip/title", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/x", "gte": 34}, {"pointer": "/visible/x", "lte": 53}, {"pointer": "/visible/w", "gte": 200}]}
{"cmd": "bounds", "target": "pr_strip/branches", "expect_result": [{"pointer": "/visible/w", "equals": 36}]}
{"cmd": "bounds", "target": "pr_strip/author", "expect_result": [{"pointer": "/visible/w", "equals": 36}]}
{"cmd": "bounds", "target": "pr_strip/moved", "expect_result": [{"pointer": "/visible/w", "equals": 36}]}
{"cmd": "bounds", "target": "pr_strip/status", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/w", "gte": 130}, {"pointer": "/visible/w", "lte": 230}]}
{"cmd": "bounds", "target": "pr_strip/status", "platforms": ["windows", "linux"], "expect_result": [{"pointer": "/visible/w", "gte": 110}, {"pointer": "/visible/w", "lte": 230}]}
// The title bar names the review by at most 48 characters of `#12 Title` (DESIGN §4.1), so the
// title leaves the command field where a long branch's name would. With the caption buttons
// at its right (Windows: 138 less room) the PRs button is its glyph alone at this width; on
// macOS it keeps its words. On Linux the runner's display has no window manager, so dv
// draws no caption buttons (README, "Xvfb") and the bar has macOS's room at its right:
// which of the two the button is there turns on the font's width, within a few pixels of
// the room, so only its height and that it is no wider than its words are held.
// (`review_chrome` holds the glyph alone on every platform, under a longer repository name.)
{"cmd": "bounds", "target": "titlebar/prs", "platforms": ["windows"], "expect_result": [{"pointer": "/visible/w", "lte": 40}, {"pointer": "/visible/h", "equals": 28}]}
{"cmd": "bounds", "target": "titlebar/prs", "platforms": ["linux"], "expect_result": [{"pointer": "/visible/w", "lte": 130}, {"pointer": "/visible/h", "equals": 28}]}
{"cmd": "bounds", "target": "titlebar/prs", "platforms": ["macos"], "expect_result": [{"pointer": "/visible/w", "gte": 70}, {"pointer": "/visible/h", "equals": 28}]}
