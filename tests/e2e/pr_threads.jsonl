{"cmd": "repo_edit", "name": "api", "github": [{"write": "src/lib.rs", "text": "// The answer,\n// and the question.\n\npub fn answer() -> u32 {\n    42\n}\n\npub fn question() -> &'static str {\n    \"what?\"\n}\n"}, {"commit": "And the question"}, {"pr": [7, "feat"]}], "save": {"third": "/github/prs/7"}, "expect_result": {"pointer": "/github/prs/7", "equals": "cac4f83ae50155e8738c983aa32004a76fad0575"}}
