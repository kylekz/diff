{"cmd": "state", "expect": [{"pointer": "/session/github_threads/1/file_level", "equals": true}, {"pointer": "/session/github_threads/1/placement", "equals": "file"}, {"pointer": "/session/github_threads/2/resolved", "equals": true}, {"pointer": "/session/github_threads/2/lines", "equals": {"start": 6, "end": 6}}, {"pointer": "/session/github_threads/3/outdated_on_github", "equals": true}, {"pointer": "/session/github_threads/3/standing", "equals": "outdated_on_github"}, {"pointer": "/session/github_threads/3/placement", "equals": "outdated"}, {"pointer": "/session/github_threads/3/in_diff", "equals": false}, {"pointer": "/session/github_threads/3/file", "equals": null}, {"pointer": "/session/github_threads/4/pending", "equals": true}, {"pointer": "/session/github_threads/4/lines", "equals": {"start": 5, "end": 5}}]}
// One whose hunk isn't the code its line holds: dv doesn't put it on that line.
{"cmd": "state", "expect": [{"pointer": "/session/github_threads/5/id", "equals": "gh:PRRT_kwDOfixtureU"}, {"pointer": "/session/github_threads/5/standing", "equals": "unplaced"}, {"pointer": "/session/github_threads/5/outdated_on_github", "equals": false}, {"pointer": "/session/github_threads/5/placement", "equals": "outdated"}, {"pointer": "/session/github_threads/5/in_diff", "equals": false}, {"pointer": "/session/github_threads/5/file", "equals": null}, {"pointer": "/session/github_threads/5/can_resolve", "equals": false}]}
// Where they show: the outdated one and the one dv can't place in the section, the one on the whole file heading its file; counted apart.
{"cmd": "state", "expect": [{"pointer": "/stream/not_in_diff/github", "equals": ["PRRT_kwDOfixtureO", "PRRT_kwDOfixtureU"]}, {"pointer": "/stream/not_in_diff/threads", "equals": []}, {"pointer": "/stream/files/0/heading", "equals": ["gh:PRRT_kwDOfixtureF"]}, {"pointer": "/session/files/0/open_threads", "equals": 3}, {"pointer": "/shell/status/review", "equals": "Draft · round 1 · no comments · 5 on GitHub"}, {"pointer": "/shell/empty_state", "equals": null}]}
{"cmd": "state", "expect": [{"pointer": "/comments_list/rows", "len": 0}, {"pointer": "/comments_list/github", "len": 5}, {"pointer": "/comments_list/github/0/id", "equals": "gh:PRRT_kwDOfixtureO"}, {"pointer": "/comments_list/github/0/outdated", "equals": true}, {"pointer": "/comments_list/github/1/id", "equals": "gh:PRRT_kwDOfixtureU"}, {"pointer": "/comments_list/github/1/unplaced", "equals": true}, {"pointer": "/comments_list/github/0/unplaced", "equals": false}, {"pointer": "/comments_list/github/1/location", "equals": "src/lib.rs:3"}, {"pointer": "/comments_list/github/2/location", "equals": "src/lib.rs (file)"}, {"pointer": "/comments_list/github/3/location", "equals": "src/lib.rs:2"}, {"pointer": "/comments_list/github/3/summary", "equals": "Is 42 the right answer?"}, {"pointer": "/comments_list/github/4/pending_on_github", "equals": true}]}
