{"cmd": "key", "keystroke": "]"}
{"cmd": "settle", "expect": [{"pointer": "/session/focused_thread", "equals": "gh:PRRT_kwDOfixtureF"}, {"pointer": "/session/resolve_notice", "equals": null}]}
{"cmd": "key", "keystroke": "]"}
{"cmd": "settle", "expect": {"pointer": "/session/focused_thread", "equals": "gh:PRRT_kwDOfixtureA"}}

// `R` on a GitHub card: replies post with the review, which a later version submits.
{"cmd": "key", "keystroke": "r"}
