{"cmd": "cli", "cwd": "repos/api", "args": ["comment", "show", "gh:PRRT_kwDOfixtureU"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/stdout", "contains": "gh:PRRT_kwDOfixtureU  open  src/lib.rs (can't be placed here, was 3)\nas commented on GitHub (can't be placed here):\n  + | pub fn answer() -> u32 {\n  + |     42\n> + |     // unreachable\ngithub hubot:\n    Should this panic instead?\n"}]}
{"cmd": "cli", "cwd": "repos/api", "args": ["review", "show", "${review}", "--json"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/review/threads/open", "equals": 0}, {"pointer": "/json/review/pr/threads", "equals": {"open": 5, "resolved": 1}}]}
{"cmd": "cli", "cwd": "repos/api", "args": ["comment", "resolve", "gh:PRRT_kwDOfixtureA", "--json"], "expect_result": [{"pointer": "/exit", "equals": 1}, {"pointer": "/json/error/code", "equals": "not_allowed"}]}

// `]` steps through the ones GitHub doesn't call resolved, the section's first.
{"cmd": "click", "target": "comments_list/gh:PRRT_kwDOfixtureO"}
{"cmd": "settle", "expect": {"pointer": "/session/focused_thread", "equals": "gh:PRRT_kwDOfixtureO"}}
{"cmd": "key", "keystroke": "]"}
{"cmd": "settle", "expect": {"pointer": "/session/focused_thread", "equals": "gh:PRRT_kwDOfixtureU"}}
