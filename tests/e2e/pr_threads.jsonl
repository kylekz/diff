{"cmd": "cli", "cwd": "repos/api", "args": ["comment", "show", "gh:PRRT_kwDOfixtureP", "--json"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/thread/placement", "equals": "moved"}, {"pointer": "/json/thread/anchor/original/start_line", "equals": 8}, {"pointer": "/json/thread/anchor/current/start_line", "equals": 7}, {"pointer": "/json/thread/github/pending", "equals": true}]}
