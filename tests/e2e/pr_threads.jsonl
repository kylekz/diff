{"cmd": "key", "keystroke": "x"}
{"cmd": "settle", "expect": [{"pointer": "/session/resolve_notice", "equals": "PRRT_kwDOfixtureU"}, {"pointer": "/session/github_threads/5/resolving", "equals": null}, {"pointer": "/session/github_threads/5/resolved", "equals": false}]}
{"gh_log": {"stdin_contains": "ReviewThread(input"}, "expect_result": {"pointer": "", "len": 0}}
