{"scenario": {"window_size": "1440x900", "gh": "../fixtures/gh/pr_threads.json", "description": "GitHub's threads on a pull request's review in a repository reached through `dv backend --stdio` (PLAN §9.6, §5.1), as a WSL repository's is: the fixture GitHub's clone is seeded behind the loopback connection, so the commits' text the threads' anchors are read from, the mirror and the refresh after a Resolve all go through the remote backend, while `gh` (the mutation too) runs on the app's side."}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "seed_repo", "name": "api", "backend": "loopback", "github": [{"branch": "feat"}, {"checkout": "feat"}, {"write": "src/lib.rs", "text": "pub fn answer() -> u32 {\n    42\n}\n\npub fn question() -> &'static str {\n    \"what?\"\n}\n"}, {"commit": "Add the answer"}, {"pr": [7, "feat"]}], "expect_result": {"pointer": "/github/prs/7", "equals": "fdd652adef6c3a595882996fdf54e7741422d693"}}
{"cmd": "open_pr", "path": "${data_dir}/repos/api", "pr": "#7", "save": {"review": "/review_id"}, "expect_result": {"pointer": "/created", "equals": true}}
{"cmd": "wait_for", "pointer": "/session/github_threads", "len": 6, "timeout_ms": 20000}
// The anchors were read where the repository lives: each thread stands where GitHub has it.
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/shell/banner", "equals": null}, {"pointer": "/shell/backend_banner", "equals": null}, {"pointer": "/backends/0/name", "equals": "loopback"}, {"pointer": "/backends/0/state", "equals": "connected"}, {"pointer": "/session/pr/stale", "equals": null}, {"pointer": "/session/github_threads/0/standing", "equals": "anchored"}, {"pointer": "/session/github_threads/0/placement", "equals": "unchanged"}, {"pointer": "/session/github_threads/0/lines", "equals": {"start": 2, "end": 2}}, {"pointer": "/session/github_threads/1/placement", "equals": "file"}, {"pointer": "/session/github_threads/2/lines", "equals": {"start": 6, "end": 6}}, {"pointer": "/session/github_threads/3/standing", "equals": "outdated_on_github"}, {"pointer": "/session/github_threads/4/lines", "equals": {"start": 5, "end": 5}}, {"pointer": "/session/github_threads/5/standing", "equals": "unplaced"}, {"pointer": "/stream/not_in_diff/github", "equals": ["PRRT_kwDOfixtureO", "PRRT_kwDOfixtureU"]}]}
// The CLI, reading the same store through its own backend, says the same.
{"cmd": "cli", "cwd": "repos/api", "args": ["comment", "show", "gh:PRRT_kwDOfixtureA", "--json"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/thread/placement", "equals": "unchanged"}, {"pointer": "/json/thread/code", "equals": "    42"}]}

// Resolve: gh runs here, the refresh's fetch and the mirror's write go through the connection.
{"cmd": "click", "target": "thread/gh:PRRT_kwDOfixtureA/resolve"}
{"cmd": "wait_for", "pointer": "/session/github_threads/0/resolved", "equals": true, "timeout_ms": 20000}
{"cmd": "settle", "timeout_ms": 20000, "expect": [{"pointer": "/session/github_threads/0/error", "equals": null}, {"pointer": "/session/pr/stale", "equals": null}, {"pointer": "/shell/status/review", "equals": "Draft · round 1 · no comments · 4 on GitHub"}, {"pointer": "/backends/0/state", "equals": "connected"}]}
{"gh_log": {"stdin_contains": "ReviewThread(input"}, "expect_result": [{"pointer": "", "len": 1}, {"pointer": "/0/stdin", "contains": "{ resolveReviewThread("}, {"pointer": "/0/stdin", "contains": "\"thread\":\"PRRT_kwDOfixtureA\""}]}
{"cmd": "cli", "cwd": "repos/api", "args": ["review", "show", "${review}", "--json"], "expect_result": [{"pointer": "/exit", "equals": 0}, {"pointer": "/json/review/pr/threads", "equals": {"open": 4, "resolved": 2}}]}
{"cmd": "quit"}
