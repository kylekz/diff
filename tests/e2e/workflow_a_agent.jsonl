// The fix: a cap, with two lines (and a blank) inserted above the thread's lines.
{"cmd": "repo_edit", "name": "api-server", "steps": [{"write": "src/lib/cache.ts", "text": "/** At most this many entries; the oldest goes first. */\nconst MAX_ENTRIES = 1_000;\n\nconst entries = new Map<string, { value: unknown; until: number }>();\n\nexport const cache = {\n  get<T>(key: string): T | undefined {\n    const entry = entries.get(key);\n    return entry && entry.until > Date.now() ? (entry.value as T) : undefined;\n  },\n  set(key: string, value: unknown, ttl: number) {\n    if (entries.size >= MAX_ENTRIES) {\n      const oldest = entries.keys().next().value;\n      if (oldest !== undefined) entries.delete(oldest);\n    }\n    entries.set(key, { value, until: Date.now() + ttl });\n  },\n};\n"}]}
