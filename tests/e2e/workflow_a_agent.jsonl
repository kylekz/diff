{"cmd": "seed_repo", "name": "api-server", "steps": [{"config": ["core.autocrlf", "true"]}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await db.users.find(req.params.id);\n  if (!user) return res.status(404).end();\n  res.json({ id: user.id, name: user.name });\n});\n"}, {"write": "src/lib/http.ts", "text": "export async function get(url: string) {\n\tconst response = await fetch(url, { signal: AbortSignal.timeout(5000) });\n\treturn response.json();\n}\n"}, {"write": "src/lib/legacy.ts", "text": "export const LEGACY = true;\nexport function old() {\n  return LEGACY;\n}\n"}, {"write": "src/db/schema.ts", "text": "export interface UserRow {\n  id: string;\n  name: string;\n}\n"}, {"write_crlf": "README.md", "text": "# api-server\n\nThe users API.\n\nRun it with npm start.\n"}, {"commit": "base"}, {"write": "src/routes/users.ts", "text": "import { db } from \"../db\";\nimport { cache } from \"../lib/cache\";\nimport type { User } from \"../types\";\n\nexport const users = Router();\n\nexport async function fetchUser(id: string): Promise<User | null> {\n  const key = `user:${id}`;\n  const hit = cache.get<User>(key);\n  if (hit) return hit;\n  const user = await db.users.find(id);\n  if (user) cache.set(key, user, 60_000);\n  return user;\n}\n\nusers.get(\"/:id\", async (req, res) => {\n  const user = await fetchUser(req.params.id);\n  if (!user) return res.status(404).json({ error: \"not_found\" });\n  res.json({ id: user.id, name: user.name, email: user.email });\n});\n"}, {"write": "src/lib/cache.ts", "text": "const entries = new Map<string, { value: unknown; until: number }>();\n\nexport const cache = {\n  get<T>(key: string): T | undefined {\n    const entry = entries.get(key);\n    return entry && entry.until > Date.now() ? (entry.value as T) : undefined;\n  },\n  set(key: string, value: unknown, ttl: number) {\n    entries.set(key, { value, until: Date.now() + ttl });\n  },\n};\n"}, {"write": "src/lib/http.ts", "text": "import { config } from \"../config\";\n\nexport async function get(url: string) {\n\tconst response = await fetch(url, { signal: AbortSignal.timeout(config.timeoutMs) });\n\treturn response.json();\n}\n"}, {"remove": "src/lib/legacy.ts"}, {"git": ["mv", "src/db/schema.ts", "src/db/models.ts"]}, {"write_crlf": "README.md", "text": "# api-server\n\nThe users API, with a cache in front of the database.\n\nRun it with npm start.\n"}, {"write": "src/routes/users.test.ts", "text": "import { fetchUser } from \"./users\";\n\ntest(\"caches a user\", async () => {\n  expect(await fetchUser(\"a\")).toEqual(await fetchUser(\"a\"));\n});\n"}]}
